    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
